{
  "name": "markedit-comments",
  "version": "0.1.0",
  "description": "Anchored review comments in MarkEdit's preview, stored in the Markdown as W3C Web Annotation selectors.",
  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc",
    "build": "vite build",
    "test": "vitest run",
    "reload": "osascript -e 'quit app \"MarkEdit\"' -e 'delay 1' -e 'launch app \"MarkEdit\"'",
    "uninstall": "rm -f ~/Library/Containers/app.cyan.markedit/Data/Documents/scripts/markedit-comments.js"
  },
  "devDependencies": {
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-task-lists": "^2.1.1",
    "markedit-api": "https://github.com/MarkEdit-app/MarkEdit-api#v0.32.0",
    "markedit-vite": "https://github.com/MarkEdit-app/MarkEdit-vite#v0.6.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}

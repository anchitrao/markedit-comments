{
  "compilerOptions": {
    "typeRoots": [
      "./node_modules/@types"
    ],
    "module": "esnext",
    "target": "esnext",
    "lib": [
      "es2021",
      "dom",
      "dom.iterable"
    ],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "main.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts"
  ]
}